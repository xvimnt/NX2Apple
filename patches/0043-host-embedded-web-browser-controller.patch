+
+<script>
+// Button Bits matching Switch nn::hid::NpadButton / dm_input.h
+const BITS = {
+  A: 1, B: 2, X: 4, Y: 8, LS: 16, RS: 32,
+  L: 64, R: 128, ZL: 256, ZR: 512,
+  PLUS: 1024, MINUS: 2048,
+  HOME: 0, CAPTURE: 0
+};
+
+// Keyboard mappings for desktop preview
+const KEY_MAP = {
+  KeyX: 1, Enter: 1,
+  KeyZ: 2, Backspace: 2,
+  KeyC: 4,
+  KeyV: 8,
+  KeyQ: 64,
+  KeyE: 128,
+  Digit1: 256,
+  Digit3: 512,
+  Equal: 1024,
+  Minus: 2048
+};
+const STICK_KEYS = ['KeyW', 'KeyA', 'KeyS', 'KeyD'];
+
+let hapticsEnabled = true;
+function triggerHaptic(ms = 18) {
+  if (hapticsEnabled && navigator.vibrate) {
+    try { navigator.vibrate(ms); } catch (e) {}
+  }
+}
+
+document.getElementById('haptic-toggle').addEventListener('click', () => {
+  hapticsEnabled = !hapticsEnabled;
+  triggerHaptic(30);
+  document.getElementById('haptic-icon').style.color = hapticsEnabled ? '#22C55E' : '#64748b';
+});
+
+// Touch and Button State
+const activeTouches = new Map(); // touchId -> bitmask
+const activeKeys = new Set();
+let lx = 0, ly = 0;
+let buttonMask = 0;
+let sentState = '';
+let lastAck = 0;
+let playerNum = null;
+let ws = null;
+let pingStart = 0;
+
+const statusDot = document.getElementById('status-dot');
+const statusWave = document.getElementById('status-wave');
+const statusText = document.getElementById('status-text');
+const playerSlot = document.getElementById('player-slot');
+
+function setStatusState(color, label, slotStr) {
+  statusDot.style.backgroundColor = color;
+  statusWave.style.backgroundColor = color;
+  if (label) statusText.textContent = label;
+  if (slotStr) playerSlot.textContent = slotStr;
+}
+
+function refreshButtonsUI() {
+  const prevMask = buttonMask;
+  buttonMask = 0;
+  for (const b of activeTouches.values()) buttonMask |= b;
+  for (const k of activeKeys) buttonMask |= (KEY_MAP[k] || 0);
+
+  if ((buttonMask & ~prevMask)) triggerHaptic(15);
+
+  document.querySelectorAll('.gamepad-btn').forEach(btn => {
+    const key = btn.getAttribute('data-key');
+    const bit = BITS[key] || 0;
+    if (bit) {
+      btn.classList.toggle('pressed', !!(buttonMask & bit));
+    }
+  });
+
+  sendState(false);
+}
+
+function sendState(force) {
+  const msg = buttonMask + ',' + lx.toFixed(3) + ',' + ly.toFixed(3);
+  if ((force || msg !== sentState) && ws && ws.readyState === WebSocket.OPEN) {
+    ws.send(msg);
+    sentState = msg;
+  }
+}
+
+// Multitouch handling for all buttons
+function bitAtPoint(x, y) {
+  const el = document.elementFromPoint(x, y);
+  const btn = el && el.closest('.gamepad-btn');
+  if (!btn) return 0;
+  const key = btn.getAttribute('data-key');
+  return BITS[key] || 0;
+}
+
+// Analog Stick Touch Logic
+const stickBase = document.getElementById('joystick-base');
+const stickThumb = document.getElementById('joystick-thumb');
+let stickTouchId = null;
+let baseRect = null;
+
+function updateStick(clientX, clientY) {
+  if (!baseRect) baseRect = stickBase.getBoundingClientRect();
+  const maxR = baseRect.width * 0.38; // Slightly larger throw ratio for easier reaching of 100% deflection
+  const cx = baseRect.left + baseRect.width / 2;
+  const cy = baseRect.top + baseRect.height / 2;
+  let dx = clientX - cx;
+  let dy = clientY - cy;
+  const dist = Math.hypot(dx, dy);
+  if (dist > maxR) {
+    dx = (dx / dist) * maxR;
+    dy = (dy / dist) * maxR;
+  }
+  stickThumb.style.transform = `translate3d(${dx}px, ${dy}px, 0)`;
+
+  // Normalized direct coordinates [-1.0, 1.0]
+  let normX = dx / maxR;
+  let normY = -dy / maxR; // Switch Y is inverted (up is positive)
+
+  // Subtle deadzone
+  const mag = Math.hypot(normX, normY);
+  if (mag < 0.05) {
+    lx = 0;
+    ly = 0;
+  } else {
+    // Linear & responsive: no sticky snapping or locking onto down/up!
+    // A clean circular mapping with gentle axial damping only when clearly horizontal/vertical.
+    lx = Math.max(-1.0, Math.min(1.0, normX));
+    ly = Math.max(-1.0, Math.min(1.0, normY));
+  }
+
+  sendState(false);
+}
+
+function resetStick() {
+  stickThumb.style.transform = 'translate3d(0, 0, 0)';
+  lx = 0; ly = 0;
+  sendState(false);
+}
+
+// Global Touch Listeners
+window.addEventListener('touchstart', (e) => {
+  e.preventDefault();
+  for (let i = 0; i < e.changedTouches.length; i++) {
+    const t = e.changedTouches[i];
+    if (!baseRect) baseRect = stickBase.getBoundingClientRect();
+    const cx = baseRect.left + baseRect.width / 2;
+    const cy = baseRect.top + baseRect.height / 2;
+
+    // Check if touch is inside analog stick base
+    if (stickTouchId === null && Math.hypot(t.clientX - cx, t.clientY - cy) < baseRect.width * 0.58) {
+      stickTouchId = t.identifier;
+      triggerHaptic(10);
+      updateStick(t.clientX, t.clientY);
+    } else {
+      const bit = bitAtPoint(t.clientX, t.clientY);
+      if (bit) activeTouches.set(t.identifier, bit);
+    }
+  }
+  refreshButtonsUI();
+}, { passive: false });
+
+window.addEventListener('touchmove', (e) => {
+  e.preventDefault();
+  for (let i = 0; i < e.changedTouches.length; i++) {
+    const t = e.changedTouches[i];
+    if (t.identifier === stickTouchId) {
+      updateStick(t.clientX, t.clientY);
+    } else if (activeTouches.has(t.identifier)) {
+      activeTouches.set(t.identifier, bitAtPoint(t.clientX, t.clientY));
+    }
+  }
+  refreshButtonsUI();
+}, { passive: false });
+
+window.addEventListener('touchend', (e) => {
+  for (let i = 0; i < e.changedTouches.length; i++) {
+    const t = e.changedTouches[i];
+    if (t.identifier === stickTouchId) {
+      stickTouchId = null;
+      resetStick();
+    }
+    activeTouches.delete(t.identifier);
+  }
+  refreshButtonsUI();
+}, { passive: false });
+
+window.addEventListener('touchcancel', (e) => {
+  for (let i = 0; i < e.changedTouches.length; i++) {
+    const t = e.changedTouches[i];
+    if (t.identifier === stickTouchId) {
+      stickTouchId = null;
+      resetStick();
+    }
+    activeTouches.delete(t.identifier);
+  }
+  refreshButtonsUI();
+}, { passive: false });
+
+// Mouse fallback for desktop testing
+let isMouseDown = false;
+stickBase.addEventListener('mousedown', (e) => {
+  isMouseDown = true;
+  baseRect = stickBase.getBoundingClientRect();
+  updateStick(e.clientX, e.clientY);
+});
+window.addEventListener('mousemove', (e) => {
+  if (isMouseDown) updateStick(e.clientX, e.clientY);
+});
+window.addEventListener('mouseup', () => {
+  if (isMouseDown) {
+    isMouseDown = false;
+    resetStick();
+  }
+});
+
+// Desktop Keyboard mapping
+window.addEventListener('keydown', (e) => {
+  if (!(e.code in KEY_MAP) && !STICK_KEYS.includes(e.code)) return;
+  e.preventDefault();
+  activeKeys.add(e.code);
+  if (stickTouchId === null) {
+    lx = (activeKeys.has('KeyD') ? 1 : 0) - (activeKeys.has('KeyA') ? 1 : 0);
+    ly = (activeKeys.has('KeyW') ? 1 : 0) - (activeKeys.has('KeyS') ? 1 : 0);
+  }
+  refreshButtonsUI();
+});
+
+window.addEventListener('keyup', (e) => {
+  if (e.code in KEY_MAP || STICK_KEYS.includes(e.code)) {
+    e.preventDefault();
+    activeKeys.delete(e.code);
+    if (stickTouchId === null) {
+      lx = (activeKeys.has('KeyD') ? 1 : 0) - (activeKeys.has('KeyA') ? 1 : 0);
+      ly = (activeKeys.has('KeyW') ? 1 : 0) - (activeKeys.has('KeyS') ? 1 : 0);
+    }
+    refreshButtonsUI();
+  }
+});
+
+// WebSocket Connection
+function connectWS() {
+  setStatusState('#eab308', 'Connecting…', 'P-');
+  const wsUrl = 'ws://' + location.host + '/ws';
+  ws = new WebSocket(wsUrl);
+
+  ws.onopen = () => {
+    setStatusState('#38bdf8', 'Connected', 'P-');
+    sendState(true);
+  };
+
+  ws.onmessage = (m) => {
+    lastAck = Date.now();
+    const data = m.data;
+    if (data.startsWith('player ')) {
+      playerNum = parseInt(data.split(' ')[1], 10);
+      setStatusState('#22c55e', 'Connected', 'P' + playerNum);
+    }
+  };
+
+  ws.onclose = () => {
+    playerNum = null;
+    setStatusState('#ef4444', 'Disconnected', 'P-');
+    setTimeout(connectWS, 1500);
+  };
+}
+
+// 50ms keep-alive tick
+setInterval(() => {
+  sendState(true);
+}, 50);
+
+window.addEventListener('resize', () => {
+  baseRect = null;
+});
+
+connectWS();
+</script>
+</body>
+</html>
